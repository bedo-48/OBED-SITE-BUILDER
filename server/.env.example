# PostgreSQL (Neon) connection string
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Comma-separated list of allowed frontend origins (CORS + better-auth)
TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174

# better-auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# development | production
NODE_ENV=development

# OpenRouter API key (used by the OpenAI SDK)
AI_API_KEY=sk-or-...

# Frontend base URL (used for Stripe success/cancel redirects)
CLIENT_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Modele OpenRouter utilise pour la generation
AI_MODEL=google/gemma-4-31b-it:free,z-ai/glm-5.2:free,cohere/north-mini-code:free
# false = pas d'etape d'enrichissement, donc deux fois moins d'appels
AI_ENHANCE=true
